<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================ SEARCH ============================ -->
        <record id="view_pilar_po_search" model="ir.ui.view">
            <field name="name">pilar.po.search</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <search string="Cari Purchase Order">
                    <field name="name" string="Nomor PO"/>
                    <field name="customer_id" string="Pelanggan"/>
                    <field name="telegram_sender" string="Pengirim Telegram"/>
                    <field name="delivery_date" string="Tanggal Kirim"/>
                    <filter name="filter_bukti" string="Bukti Diterima"
                            domain="[('state', '=', 'bukti_diterima')]"/>
                    <filter name="filter_periksa" string="Dalam Pemeriksaan"
                            domain="[('state', '=', 'dalam_pemeriksaan')]"/>
                    <filter name="filter_kembali" string="Dikembalikan"
                            domain="[('state', '=', 'dikembalikan')]"/>
                    <filter name="filter_keputusan" string="Menunggu Keputusan"
                            domain="[('state', '=', 'menunggu_keputusan')]"/>
                    <filter name="filter_tunda" string="Ditunda"
                            domain="[('state', '=', 'ditunda')]"/>
                    <filter name="filter_sah" string="Disahkan"
                            domain="[('state', '=', 'disahkan')]"/>
                    <filter name="filter_batal" string="Dibatalkan"
                            domain="[('state', '=', 'dibatalkan')]"/>
                    <separator/>
                    <filter name="filter_overdue" string="Melewati Batas Waktu"
                            domain="[('is_overdue', '=', True)]"/>
                    <filter name="filter_tanggal_kirim" string="Rentang Tanggal Kirim"
                            date="delivery_date"/>
                    <filter name="filter_mbg" string="Segmen MBG"
                            domain="[('customer_segment', '=', 'mbg')]"/>
                    <filter name="filter_horeca" string="Segmen Horeca"
                            domain="[('customer_segment', '=', 'horeca')]"/>
                    <group expand="0" string="Kelompokkan Berdasarkan">
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_customer" string="Pelanggan"
                                context="{'group_by': 'customer_id'}"/>
                        <filter name="group_delivery" string="Tanggal Pengiriman"
                                context="{'group_by': 'delivery_date'}"/>
                        <filter name="group_segment" string="Segmen"
                                context="{'group_by': 'customer_segment'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================ KANBAN ============================ -->
        <record id="view_pilar_po_kanban" model="ir.ui.view">
            <field name="name">pilar.po.kanban.dashboard</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="state" quick_create="false">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="customer_segment"/>
                    <field name="delivery_date"/>
                    <field name="state"/>
                    <field name="is_overdue"/>
                    <field name="stage_deadline"/>
                    <field name="hours_late"/>
                    <field name="total_quantity"/>
                    <field name="line_count"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click p-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span t-if="record.is_overdue.raw_value"
                                          class="badge badge-danger">Terlambat</span>
                                </div>
                                <div class="mt-1">
                                    <i class="fa fa-building-o text-muted" title="Pelanggan"/>
                                    <field name="customer_id"/>
                                </div>
                                <div class="text-muted small">
                                    <field name="customer_segment"/>
                                    &#183; kirim <field name="delivery_date"/>
                                </div>
                                <div class="mt-1 small">
                                    <span class="text-muted">Baris:</span>
                                    <field name="line_count"/>
                                    &#183;
                                    <span class="text-muted">Qty:</span>
                                    <field name="total_quantity"/>
                                </div>
                                <div t-if="record.is_overdue.raw_value" class="text-danger small mt-1">
                                    <i class="fa fa-clock-o"/>
                                    lewat <field name="hours_late"/> jam
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================ LIST ============================ -->
        <record id="view_pilar_po_list" model="ir.ui.view">
            <field name="name">pilar.po.list</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <tree string="Purchase Order"
                      decoration-info="state == 'dalam_pemeriksaan'"
                      decoration-warning="state in ['menunggu_keputusan', 'ditunda']"
                      decoration-danger="is_overdue or state in ['dikembalikan', 'dibatalkan']"
                      decoration-success="state == 'disahkan'"
                      decoration-muted="state == 'dibatalkan'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="customer_segment"/>
                    <field name="delivery_date"/>
                    <field name="state" widget="badge"/>
                    <field name="validation_result" optional="show"/>
                    <field name="version" optional="show"/>
                    <field name="line_count" optional="show"/>
                    <field name="total_quantity" optional="hide"/>
                    <field name="stage_deadline" optional="show"/>
                    <field name="is_overdue" optional="hide"/>
                    <field name="hours_late" optional="hide"/>
                    <field name="submitted_at" optional="show"/>
                    <field name="checked_by" optional="hide"/>
                    <field name="decided_by" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- ============================ FORM ============================ -->
        <record id="view_pilar_po_form" model="ir.ui.view">
            <field name="name">pilar.po.form</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <form string="Purchase Order">
                    <header>
                        <button name="action_start_check" string="Mulai Pemeriksaan"
                                type="object" class="oe_highlight"
                                invisible="state != 'bukti_diterima'"/>
                        <button name="action_validate" string="Periksa Kelengkapan"
                                type="object"
                                invisible="state not in ['bukti_diterima', 'dalam_pemeriksaan', 'dikembalikan']"/>
                        <button name="action_submit_decision" string="Teruskan ke Keputusan"
                                type="object" class="oe_highlight"
                                invisible="state != 'dalam_pemeriksaan' or validation_result != 'lolos'"/>
                        <button name="action_approve" string="Sahkan PO"
                                type="object" class="oe_highlight"
                                invisible="state not in ['menunggu_keputusan', 'ditunda']"/>
                        <button name="action_postpone" string="Tunda"
                                type="object"
                                invisible="state not in ['menunggu_keputusan', 'ditunda']"/>
                        <button name="action_return" string="Kembalikan untuk Perbaikan"
                                type="object"
                                invisible="state not in ['bukti_diterima', 'dalam_pemeriksaan', 'menunggu_keputusan']"/>
                        <button name="action_resubmit" string="Terima Perbaikan"
                                type="object"
                                invisible="state != 'dikembalikan'"/>
                        <button name="action_cancel" string="Batalkan PO"
                                type="object"
                                invisible="state in ['disahkan', 'dibatalkan']"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="bukti_diterima,dalam_pemeriksaan,dikembalikan,menunggu_keputusan,ditunda,disahkan"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_history" type="object"
                                    class="oe_stat_button" icon="fa-history">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Riwayat</span>
                                    <span class="o_stat_text">Audit PO</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Nomor PO"/>
                            <h1><field name="name" placeholder="PO/2026/11/0001"/></h1>
                        </div>
                        <group>
                            <group string="Rincian Pesanan">
                                <field name="customer_id"/>
                                <field name="customer_segment"/>
                                <field name="customer_phone"/>
                                <field name="delivery_date"/>
                                <field name="delivery_address" widget="text"/>
                                <field name="telegram_sender"/>
                                <field name="priority"/>
                                <field name="notes" widget="text"/>
                            </group>
                            <group string="Bukti Transaksi (Telegram)">
                                <field name="evidence_preview" widget="image"
                                       options="{'size': [300, 380]}" readonly="1"
                                       nolabel="1"/>
                                <field name="evidence_caption" readonly="1"/>
                                <field name="evidence_count" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Status &amp; Batas Waktu">
                                <field name="submitted_at"/>
                                <field name="stage_started_at"/>
                                <field name="stage_deadline"/>
                                <field name="is_overdue"/>
                                <field name="hours_late"/>
                                <field name="responsible_role"/>
                                <field name="created_at"/>
                                <field name="updated_at"/>
                            </group>
                            <group string="Validasi &amp; Keputusan">
                                <field name="current_version_id"/>
                                <field name="version"/>
                                <field name="config_id"/>
                                <field name="created_by"/>
                                <field name="validation_result"/>
                                <field name="checked_by"/>
                                <field name="checked_at"/>
                                <field name="decided_by"/>
                                <field name="decision_at"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Baris Pesanan" name="lines">
                                <field name="item_ids">
                                    <tree editable="bottom">
                                        <field name="commodity_name"/>
                                        <field name="quality_specification"/>
                                        <field name="quantity"/>
                                        <field name="unit_name"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Versi Dokumen" name="versions">
                                <field name="version_ids" readonly="1">
                                    <tree>
                                        <field name="version_number"/>
                                        <field name="created_by"/>
                                        <field name="delivery_date"/>
                                        <field name="delivery_address"/>
                                        <field name="is_current"/>
                                        <field name="correction_note"/>
                                        <field name="created_at"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Pemeriksaan &amp; Validasi" name="validation">
                                <group>
                                    <group string="Alasan &amp; Catatan">
                                        <field name="return_reason"/>
                                        <field name="return_note" widget="text"/>
                                        <field name="postpone_reason" widget="text"/>
                                        <field name="cancel_reason" widget="text"/>
                                    </group>
                                    <group string="Hasil Pemeriksaan">
                                        <field name="validation_result"/>
                                        <field name="checked_by"/>
                                        <field name="checked_at"/>
                                    </group>
                                </group>
                                <separator string="Catatan Validasi Otomatis"/>
                                <field name="validation_message" nolabel="1" readonly="1"/>
                                <separator string="Riwayat Validasi Versi Ini"/>
                                <field name="validation_ids" readonly="1">
                                    <tree>
                                        <field name="validated_at"/>
                                        <field name="validation_result"/>
                                        <field name="config_id"/>
                                        <field name="validation_details"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Bukti Transaksi" name="evidence">
                                <field name="evidence_ids">
                                    <tree>
                                        <field name="file_name"/>
                                        <field name="image" widget="image"
                                               options="{'size': [90, 110]}"/>
                                        <field name="evidence_type"/>
                                        <field name="sender_telegram_id"/>
                                        <field name="telegram_message_id"/>
                                        <field name="message_text"/>
                                        <field name="received_at"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Keputusan" name="decisions">
                                <field name="approval_ids" readonly="1">
                                    <tree>
                                        <field name="decision_at"/>
                                        <field name="user_id"/>
                                        <field name="decision_type"/>
                                        <field name="reason"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Riwayat &amp; Audit" name="history">
                                <field name="audit_ids" readonly="1">
                                    <tree>
                                        <field name="created_at"/>
                                        <field name="user_id"/>
                                        <field name="version_id"/>
                                        <field name="action_type"/>
                                        <field name="old_status"/>
                                        <field name="new_status"/>
                                        <field name="duration_hours"/>
                                        <field name="reason"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================ GRAPH / PIVOT / CALENDAR ============================ -->
        <record id="view_pilar_po_graph" model="ir.ui.view">
            <field name="name">pilar.po.graph</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <graph string="Purchase Order per Status" type="bar" sample="1">
                    <field name="state"/>
                    <field name="customer_segment"/>
                    <field name="total_quantity" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_pilar_po_pivot" model="ir.ui.view">
            <field name="name">pilar.po.pivot</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <pivot string="Rekap Purchase Order">
                    <field name="state" type="row"/>
                    <field name="customer_segment" type="col"/>
                    <field name="total_quantity" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_pilar_po_calendar" model="ir.ui.view">
            <field name="name">pilar.po.calendar</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <calendar string="Jadwal Pengiriman" date_start="delivery_date"
                          color="state" mode="month">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="delivery_address"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <record id="view_pilar_po_overdue_list" model="ir.ui.view">
            <field name="name">pilar.po.overdue.list</field>
            <field name="model">pilar.po</field>
            <field name="arch" type="xml">
                <tree string="Ringkasan PO Tertunda" create="false" edit="false"
                      decoration-danger="is_overdue">
                    <field name="is_overdue" column_invisible="1"/>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="state" widget="badge"/>
                    <field name="submitted_at"/>
                    <field name="stage_deadline" string="Batas Waktu"/>
                    <field name="hours_late" string="Terlambat (jam)"
                           sum="Total Terlambat (jam)"/>
                    <field name="responsible_role"/>
                    <field name="postpone_reason" optional="show"/>
                </tree>
            </field>
        </record>

        <!-- ============================ ITEM VIEWS (PURCHASING RECAP) ============================ -->
        <record id="view_pilar_po_item_search" model="ir.ui.view">
            <field name="name">pilar.po.item.search</field>
            <field name="model">pilar.po.item</field>
            <field name="arch" type="xml">
                <search string="Cari Kebutuhan Barang">
                    <field name="commodity_name"/>
                    <field name="po_id"/>
                    <field name="customer_id"/>
                    <field name="delivery_date"/>
                    <filter name="filter_approved" string="Dari PO Disahkan"
                            domain="[('order_state', '=', 'disahkan')]"/>
                    <filter name="filter_current" string="Versi Aktif"
                            domain="[('is_current_version', '=', True)]"/>
                    <filter name="filter_tanggal_kirim" string="Rentang Tanggal Kirim"
                            date="delivery_date"/>
                    <group expand="0" string="Kelompokkan Berdasarkan">
                        <filter name="group_commodity" string="Komoditas"
                                context="{'group_by': 'commodity_name'}"/>
                        <filter name="group_delivery" string="Tanggal Kirim"
                                context="{'group_by': 'delivery_date'}"/>
                        <filter name="group_customer" string="Pelanggan"
                                context="{'group_by': 'customer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_pilar_po_item_list" model="ir.ui.view">
            <field name="name">pilar.po.item.list</field>
            <field name="model">pilar.po.item</field>
            <field name="arch" type="xml">
                <tree string="Kebutuhan Barang dari PO Sah" create="false" edit="false">
                    <field name="commodity_name"/>
                    <field name="quality_specification"/>
                    <field name="quantity" sum="Total"/>
                    <field name="unit_name"/>
                    <field name="delivery_date"/>
                    <field name="customer_id"/>
                    <field name="po_id"/>
                    <field name="order_state" optional="show"/>
                    <field name="is_current_version" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_pilar_po_item_pivot" model="ir.ui.view">
            <field name="name">pilar.po.item.pivot</field>
            <field name="model">pilar.po.item</field>
            <field name="arch" type="xml">
                <pivot string="Rekap Kebutuhan Barang">
                    <field name="commodity_name" type="row"/>
                    <field name="unit_name" type="row"/>
                    <field name="delivery_date" type="col"/>
                    <field name="quantity" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ============================ AUDIT VIEWS ============================ -->
        <record id="view_pilar_audit_log_search" model="ir.ui.view">
            <field name="name">pilar.audit.log.search</field>
            <field name="model">pilar.audit.log</field>
            <field name="arch" type="xml">
                <search string="Cari Riwayat PO">
                    <field name="po_id"/>
                    <field name="user_id"/>
                    <field name="action_type"/>
                    <filter name="filter_today" string="Hari Ini"
                            domain="[('created_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Kelompokkan Berdasarkan">
                        <filter name="group_po" string="PO"
                                context="{'group_by': 'po_id'}"/>
                        <filter name="group_user" string="Pengguna"
                                context="{'group_by': 'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_pilar_audit_log_list" model="ir.ui.view">
            <field name="name">pilar.audit.log.list</field>
            <field name="model">pilar.audit.log</field>
            <field name="arch" type="xml">
                <tree string="Riwayat &amp; Audit PO" create="false" edit="false">
                    <field name="created_at"/>
                    <field name="po_id"/>
                    <field name="version_id"/>
                    <field name="user_id"/>
                    <field name="action_type"/>
                    <field name="old_status"/>
                    <field name="new_status"/>
                    <field name="duration_hours"/>
                    <field name="reason"/>
                </tree>
            </field>
        </record>

        <record id="view_pilar_audit_log_form" model="ir.ui.view">
            <field name="name">pilar.audit.log.form</field>
            <field name="model">pilar.audit.log</field>
            <field name="arch" type="xml">
                <form string="Riwayat PO" create="false" edit="false">
                    <sheet>
                        <group>
                            <field name="po_id"/>
                            <field name="version_id"/>
                            <field name="created_at"/>
                            <field name="user_id"/>
                            <field name="action_type"/>
                            <field name="old_status"/>
                            <field name="new_status"/>
                            <field name="duration_hours"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="reason"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================ ACTIONS ============================ -->
        <record id="action_pilar_po_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard PO</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">kanban,tree,form,graph,pivot,calendar</field>
            <field name="search_view_id" ref="view_pilar_po_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Belum ada Purchase Order</p>
                <p>PO yang diterima dari pelanggan melalui Telegram akan tampil di sini.</p>
            </field>
        </record>

        <record id="action_pilar_po_queue" model="ir.actions.act_window">
            <field name="name">Antrean PO - Staff Sales</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', 'in', ['bukti_diterima', 'dalam_pemeriksaan', 'dikembalikan'])]</field>
        </record>

        <record id="action_pilar_po_approval" model="ir.actions.act_window">
            <field name="name">Persetujuan PO - Director of Operational</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', 'in', ['menunggu_keputusan', 'ditunda'])]</field>
        </record>

        <record id="action_pilar_po_returned" model="ir.actions.act_window">
            <field name="name">PO Dikembalikan</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'dikembalikan')]</field>
        </record>

        <record id="action_pilar_po_approved" model="ir.actions.act_window">
            <field name="name">PO Disahkan - Persiapan Operasional</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'disahkan')]</field>
        </record>

        <record id="action_pilar_po_purchasing" model="ir.actions.act_window">
            <field name="name">Kebutuhan Barang - Purchasing</field>
            <field name="res_model">pilar.po.item</field>
            <field name="view_mode">pivot,tree</field>
            <field name="domain">[('order_state', '=', 'disahkan'), ('is_current_version', '=', True)]</field>
            <field name="context">{'search_default_group_commodity': 1, 'search_default_filter_approved': 1}</field>
            <field name="search_view_id" ref="view_pilar_po_item_search"/>
        </record>

        <record id="action_pilar_po_finance" model="ir.actions.act_window">
            <field name="name">Dasar Tagihan - Director of Finance</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'disahkan')]</field>
        </record>

        <record id="action_pilar_po_driver" model="ir.actions.act_window">
            <field name="name">Jadwal Pengiriman - Head of Driver</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="domain">[('state', '=', 'disahkan')]</field>
        </record>

        <record id="action_pilar_po_cancelled" model="ir.actions.act_window">
            <field name="name">PO Dibatalkan</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'dibatalkan')]</field>
        </record>

        <record id="action_pilar_po_overdue" model="ir.actions.act_window">
            <field name="name">Ringkasan PO Tertunda</field>
            <field name="res_model">pilar.po</field>
            <field name="view_mode">tree,form,pivot</field>
            <field name="view_id" ref="view_pilar_po_overdue_list"/>
